async function fetchAndPopulateInlineRoutes() {
try {
// 1. جلب الـ Routes والـ Peers بالتوازي
const [routesRes, peersRes] = await Promise.all([
fetch('/api/v2/netbird/routes').catch(() => null),
fetch('/api/peers').catch(() => null)
]);

const routes = (routesRes && routesRes.ok) ? await routesRes.json() : [];
const peers = (peersRes && peersRes.ok) ? await peersRes.json() : [];

const routeInputs = document.querySelectorAll('.inline-route-field');

// 2. فحص الـ Handshake للأجهزة بالتوازي (In Parallel) مع مهلة 2.5 ثوانٍ فقط
const handshakePromises = Array.from(routeInputs).map(async (input) => {
const peerId = input.getAttribute('data-peer-id');
const peerData = peers.find(p => p.id === peerId);
const isConnected = peerData ? (peerData.connected === true) : false;

let isReachable = false;

if (isConnected) {
// إيقاف الريكويست فوراً لو تأخر عن 2.5 ثانية
const controller = new AbortController();
const timeoutId = setTimeout(() => controller.abort(), 2500);

try {
const hsRes = await fetch(`/api/peers/${peerId}/handshake`, { signal: controller.signal });
clearTimeout(timeoutId);
if (hsRes.ok) {
const hsData = await hsRes.json();
isReachable = (hsData.is_reachable === true);
}
} catch (err) {
// عند حدوث Timeout أو خطأ 500 يتحول أوفلاين فوراً دون تعطيل الصفحة
isReachable = false;
}
}

return { peerId, isConnected, isReachable, peerData };
});

// انتظار رد جميع الأجهزة معاً
const handshakeResults = await Promise.all(handshakePromises);
const handshakeMap = new Map(handshakeResults.map(item => [item.peerId, item]));

let totalEdges = routeInputs.length;
let onlineEdges = 0;
let offlineEdges = 0;

// 3. تحديث واجهة المستخدم بالنتائج
for (const input of routeInputs) {
const peerId = input.getAttribute('data-peer-id');
const peerRoute = routes.find(r => r.peer === peerId);
const hsStatus = handshakeMap.get(peerId) || {};

if (document.activeElement !== input) {
input.value = peerRoute ? peerRoute.network : '';
}

if (peerRoute) {
input.setAttribute('data-route-id', peerRoute.id);
input.setAttribute('data-route-network-id', peerRoute.network_id);
} else {
input.removeAttribute('data-route-id');
input.removeAttribute('data-route-network-id');
}

const statusBadge = document.getElementById(`status-badge-${peerId}`);
const isConnected = hsStatus.isConnected;
const isReachable = hsStatus.isReachable;
const lastSeenRaw = (hsStatus.peerData && hsStatus.peerData.last_seen) 
? hsStatus.peerData.last_seen 
: (statusBadge ? statusBadge.getAttribute('data-last-seen') : '');

if (statusBadge) {
const timeAgoText = timeAgo(lastSeenRaw);

statusBadge.style.backgroundColor = "";
statusBadge.style.color = "";

if (isConnected && isReachable) {
// متصل حقيقي (NetBird متصل + الـ Agent رد على الـ Handshake)
statusBadge.className = "badge badge-success";
statusBadge.innerHTML = `<i class="fas fa-circle" style="font-size: 0.5rem;"></i> Connected`;
onlineEdges++;
} else if (isConnected && !isReachable) {
// NetBird شايفه متصل لكن الـ Agent مش رادّ
statusBadge.className = "badge badge-inactive";
statusBadge.innerHTML = `<i class="fas fa-circle" style="font-size: 0.5rem;"></i> Offline (.${timeAgoText})`;
offlineEdges++;
} else {
// غير متصل اصلاً
statusBadge.className = "badge badge-inactive";
statusBadge.innerHTML = `<i class="fas fa-circle" style="font-size: 0.5rem;"></i> Offline (${timeAgoText})`;
offlineEdges++;
}
}
}

const totalEl = document.getElementById('total-edges-val');
const onlineEl = document.getElementById('online-edges-val');
const offlineEl = document.getElementById('offline-edges-val');

if (totalEl) totalEl.innerText = totalEdges;
if (onlineEl) onlineEl.innerText = onlineEdges;
if (offlineEl) offlineEl.innerText = offlineEdges;

} catch (error) {
console.error('Error auto-populating inline routes & statuses:', error);
}
}

