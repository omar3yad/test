_HANDSHAKE_CACHE = {}  # { peer_id: (is_reachable, timestamp) }

def get_cached_peer_handshake(peer_id, base_url, headers, cache_ttl=4):
    """كاش سريع لنتيجة الـ Handshake لمنع ضرب الـ Backend بكثافة"""
    now = time.time()
    
    with _cache_lock:
        if peer_id in _HANDSHAKE_CACHE:
            is_reachable, cached_time = _HANDSHAKE_CACHE[peer_id]
            if now - cached_time < cache_ttl:
                return is_reachable

    is_reachable = False
    try:
        hs_resp = requests.get(
            f"{base_url}/api/v1/peers/{peer_id}/handshake",
            headers=headers,
            timeout=2.0
        )
        if hs_resp.ok:
            is_reachable = hs_resp.json().get("is_reachable", False)
    except Exception:
        is_reachable = False

    with _cache_lock:
        _HANDSHAKE_CACHE[peer_id] = (is_reachable, now)

    return is_reachable

def _check_single_peer_handshake(peer, base_url, headers):
    peer_id = peer.get("id")
    is_connected = peer.get("connected", False)
    is_reachable = False

    if is_connected:
        is_reachable = get_cached_peer_handshake(peer_id, base_url, headers, cache_ttl=15)

    real_online = is_connected and is_reachable
    return {
        "id": peer_id,
        "name": peer.get("name"),
        "connected": is_connected,
        "is_reachable": is_reachable,
        "is_online": real_online,
        "last_seen": peer.get("last_seen"),
        "ip": peer.get("ip")
    }
import logging
logger = logging.getLogger(__name__)
SSE_PING_INTERVAL = 15
SSE_DATA_INTERVAL = 20
@client_bp.route('/api/peers/stream')
@login_required
def stream_peers_status():
    customer_id = session.get('client_customer_id')
    customer = Client.query.get(customer_id) if customer_id else None
    if not customer:
        return jsonify({"error": "Unauthorized"}), 401

    base_url = _get_api_base_url()
    headers = _get_api_headers()

    # ✅ جيب كل البيانات الثابتة قبل الـ generator — مرة واحدة بس
    allowed_peer_ids = get_cached_customer_peer_ids(customer)

    def generate_events():
        nonlocal allowed_peer_ids
        last_data_time = 0
        last_ping_time = 0
        # تتبع آخر وقت رفرشنا الـ allowed_peers
        last_peers_refresh = time.time()

        try:
            while True:
                now = time.time()

                # Ping كل 15 ثانية
                if now - last_ping_time >= SSE_PING_INTERVAL:
                    yield ": ping\n\n"
                    last_ping_time = now

                # ✅ رفرش الـ allowed_peer_ids كل 60 ثانية بس (مش كل cycle)
                # بدون DB query — بيستخدم الكاش الموجود
                if now - last_peers_refresh >= 60:
                    allowed_peer_ids = get_cached_customer_peer_ids(customer)
                    last_peers_refresh = now

                # Data كل 20 ثانية
                if now - last_data_time >= SSE_DATA_INTERVAL:
                    try:
                        if not allowed_peer_ids:
                            payload = {
                                "peers": [],
                                "summary": {"total": 0, "online": 0, "offline": 0}
                            }
                            yield f"data: {json.dumps(payload)}\n\n"
                            last_data_time = now
                            time.sleep(1)
                            continue

                        peers_data = get_cached_all_netbird_peers(
                            base_url, headers, cache_ttl=10
                        )
                        customer_peers = [
                            p for p in peers_data
                            if p.get("id") in allowed_peer_ids
                        ]

                        processed_peers = []
                        online_count = 0

                        if customer_peers:
                            futures = {
                                executor.submit(
                                    _check_single_peer_handshake,
                                    peer, base_url, headers
                                ): peer
                                for peer in customer_peers
                            }
                            for future in as_completed(futures, timeout=8):
                                try:
                                    res = future.result()
                                    processed_peers.append(res)
                                    if res["is_online"]:
                                        online_count += 1
                                except Exception as err:
                                    logger.error(f"Peer check error: {err}")

                        payload = {
                            "peers": processed_peers,
                            "summary": {
                                "total": len(processed_peers),
                                "online": online_count,
                                "offline": len(processed_peers) - online_count
                            }
                        }
                        yield f"data: {json.dumps(payload)}\n\n"
                        last_data_time = now

                    except Exception as e:
                        # ✅ logger عادي مش current_app.logger
                        logger.error(f"SSE data error: {e}")
                        yield f"data: {json.dumps({'error': 'fetch_failed'})}\n\n"
                        last_data_time = now

                time.sleep(1)

        except GeneratorExit:
            # ✅ logger عادي — Flask context مش مضمونة هنا
            logger.info(f"SSE closed for customer {customer_id}")
            return
        except Exception as e:
            logger.error(f"SSE fatal error: {e}")

    return Response(
        stream_with_context(generate_events()),
        mimetype='text/event-stream',
        headers={
            'Cache-Control': 'no-cache',
            'X-Accel-Buffering': 'no',
            'Connection': 'keep-alive'
        }
    )
